# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Required ────────────────────────────────────────────────────────────────
# Your Anthropic API key (get it at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase — client (Vite reads these at build time) ──────────────────────
# Create a project at supabase.com, run the SQL migrations, then paste here:
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Supabase — server (proxy.js reads these at runtime) ─────────────────────
# Same URL as above (without VITE_ prefix):
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Settings → API → JWT Secret:
SUPABASE_JWT_SECRET=your-jwt-secret
# Settings → API → service_role key (keep secret — server only):
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Proxy secret (any random string — must match VITE_PROXY_SECRET) ─────────
PROXY_SECRET=change-me-random-string
VITE_PROXY_SECRET=change-me-random-string

# ── Production server ────────────────────────────────────────────────────────
# Port to listen on (Railway/Render/Fly set this automatically)
# PORT=3000
# Allowed CORS origin (required in production):
# ALLOWED_ORIGIN=https://your-domain.com
# NODE_ENV=production
